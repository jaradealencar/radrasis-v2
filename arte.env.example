# Ambiente exclusivo da ferramenta independente; não reutilize o .env do ERP.
NODE_ENV=production
ARTE_PUBLIC_URL=http://localhost:4320
# Senha privada (mínimo 16 caracteres).
ARTE_ACCESS_PASSWORD=
# Segredo aleatório para sessões/tickets (mínimo 32 caracteres).
ARTE_SESSION_SECRET=
# Integração servidor-servidor (32+ caracteres; vazio desativa).
ARTE_INTEGRATION_API_KEY=
OPENAI_API_KEY=
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=
CPQ_GPT_SVG_MODEL=gpt-5.5
# O motor interno funciona sem serviço externo e sem API paga.
DEEPNEST_REMOTE_URL=
DEEPNEST_REMOTE_TOKEN=
