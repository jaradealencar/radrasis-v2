{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "yarn build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{docs/prompts/**/*.md,node_modules/polygon-clipping/**,node_modules/splaytree/**,node_modules/robust-predicates/**,node_modules/clipper-lib/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
