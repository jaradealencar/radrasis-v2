{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "api/**/*"],
  // client/src/cpq3d tem o próprio tsconfig (tsconfig.cpq3d.json): o @react-three/fiber acrescenta ao JSX global dezenas de elementos
  // (color, line, group...) que quebram a tipagem de ElementType/style das demais páginas se entrarem no mesmo programa.
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts", "client/src/cpq3d/**"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2020",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "downlevelIteration": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
