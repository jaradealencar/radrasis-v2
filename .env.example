# Banco de dados (MySQL) — usado pelo Drizzle e pelas queries SQL diretas (mysql2)
DATABASE_URL=mysql://user:password@host:3306/database

# Autenticação
JWT_SECRET=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Integração MubiSys (ERP)
MUBISYS_ACCESS_TOKEN=
MUBISYS_PUBLIC_KEY=

# IA / geração
GEMINI_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Servidor
PORT=3000
NODE_ENV=development
