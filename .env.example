# Banco de dados (MySQL) — usado pelo Drizzle e pelas queries SQL diretas (mysql2)
DATABASE_URL=mysql://user:password@host:3306/database

# Autenticação
JWT_SECRET=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Better Auth (Fase 3 da migração — local-only)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Segredo compartilhado pro endpoint de CRON (POST /api/scheduled/sincronizarOS)
CRON_SECRET=

# Integração MubiSys (ERP)
MUBISYS_ACCESS_TOKEN=
MUBISYS_PUBLIC_KEY=

# IA / geração
OPENAI_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Servidor
PORT=3000
NODE_ENV=development
