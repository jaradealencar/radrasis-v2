# Banco de dados (PostgreSQL / Neon) — usado pelo Drizzle e pelas queries SQL
# diretas. Driver: @neondatabase/serverless (ver server/db/db-connection.ts).
# A string é a mesma de sempre; funciona tanto local quanto na Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Autenticação
JWT_SECRET=

# Better Auth. BETTER_AUTH_URL é a URL pública do app, COM esquema e SEM
# barra no fim. Em deploy de preview na Vercel pode ficar vazia — o código
# cai no fallback de VERCEL_URL (ver server/_core/auth.ts).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Segredo compartilhado do endpoint de CRON (POST /api/scheduled/sincronizarOS).
# Quem agenda é o Upstash QStash, que encaminha este valor como header
# `x-cron-secret`. Ver docs/cron-qstash.md.
CRON_SECRET=

# Integração MubiSys (ERP)
MUBISYS_ACCESS_TOKEN=
MUBISYS_PUBLIC_KEY=

# Liga o teste de contrato (rede real) de server/__tests__/mubisys.test.ts —
# `MUBISYS_TESTE_CONTRATO=1 yarn test mubisys`. Só para teste, não é lida em
# runtime pela aplicação.
MUBISYS_TESTE_CONTRATO=

# Radar de Mercado (Inteligência de Clientes → sinais externos). SerpAPI
# (serpapi.com) — cadastro só com e-mail em https://serpapi.com/users/sign_up,
# chave em https://serpapi.com/manage-api-key. Trocado do Google Custom Search
# JSON API em 2026-09 porque o Google fechou essa API para contas novas em
# 2025 (ver docs/radar-mercado.md). Sem essa chave, o radar fica com a
# configuração pronta mas a busca desativada.
SERPAPI_KEY=

# IA / geração
OPENAI_API_KEY=

# Claude: chat de IA do Painel Financeiro, Assistente de Inteligência de Clientes
# (server/integrations/anthropic-client.ts) e Consultor da Meta (server/services/consultorLlm.ts).
ANTHROPIC_API_KEY=
# Opcionais (têm padrão no código; ver "Economia de IA" em docs/inteligencia-clientes.md):
# Consultor da Meta — modelo do Claude (padrão claude-sonnet-5), provedor único (gemini | anthropic | openai)
# e chave do Gemini (plano gratuito do Google AI Studio; se preenchida, é tentado antes do Claude).
# CONSULTOR_ANTHROPIC_MODEL=
# CONSULTOR_IA_PROVEDOR=
# GEMINI_API_KEY=
# Assistente de Clientes e chat financeiro — modelo (padrão claude-opus-5) e esforço de raciocínio
# (low | medium | high; padrão medium — "high" é mais caro e mais lento).
# ASSISTENTES_ANTHROPIC_MODEL=
# ASSISTENTES_ANTHROPIC_EFFORT=

# Storage (UploadThing)
UPLOADTHING_TOKEN=

# Resend (resend.com) — envio dos relatórios diário/semanal de monitoramento
# de uso do CRM pelos vendedores. Sem essa chave, os relatórios só ficam
# disponíveis na tela (não são enviados por e-mail).
RESEND_API_KEY=
# Destinatário dos relatórios de monitoramento do CRM. Default no código:
# jaradealencar@gmail.com (ver server/services/emailRelatorioCrm.ts).
RELATORIO_CRM_EMAIL_DESTINO=

# Campanhas WhatsApp — chave dos webhooks REST (POST /api/v1/campaigns/:id/log-send e
# /api/v1/contacts/check-quarantine), enviada como "Authorization: Bearer <chave>". Sem ela os
# webhooks respondem 503 (desligados); a tela e o tRPC não dependem dela. Ver docs/campanhas-whatsapp.md.
CAMPANHAS_API_KEY=

# Tabela de Preços — chave do export somente-leitura (GET /api/v1/price-table/export), consumido
# pelo precificador automatizado externo, enviada como "Authorization: Bearer <chave>". Sem ela o
# endpoint responde 503 (desligado); a tela e o tRPC não dependem dela.
PRICE_TABLE_API_KEY=

# Servidor
PORT=3000
NODE_ENV=development

# Senha do usuário admin criado por `yarn db:seed-admin` (só necessária ao rodar o script)
SEED_ADMIN_PASSWORD=
