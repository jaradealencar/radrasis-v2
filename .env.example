# Banco de dados (PostgreSQL, ex: Neon) — usado pelo Drizzle e pelas queries SQL diretas (pg)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Autenticação
JWT_SECRET=

# Better Auth (Fase 3 da migração — local-only)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Segredo compartilhado pro endpoint de CRON (POST /api/scheduled/sincronizarOS)
CRON_SECRET=

# Integração MubiSys (ERP)
MUBISYS_ACCESS_TOKEN=
MUBISYS_PUBLIC_KEY=

# IA / geração
OPENAI_API_KEY=

# Storage (UploadThing)
UPLOADTHING_TOKEN=

# Servidor
PORT=3000
NODE_ENV=development

# Senha do usuário admin criado por `yarn db:seed-admin` (só necessária ao rodar o script)
SEED_ADMIN_PASSWORD=
